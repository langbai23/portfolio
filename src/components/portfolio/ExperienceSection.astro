---
import T from "../T.astro";
import Icon from "../Icon.astro";
import type { Localized } from "../../data/projects";

/**
 * Team / industry-style experience, kept separate from the project list.
 * Add more entries to this array as they come.
 */
type Experience = {
  role: Localized;
  project: string;
  org: Localized;
  dates: string;
  shipped?: Localized;
  cover?: string;
  links?: { steam?: string; linkedin?: string };
  bullets: Localized[];
};

const EXPERIENCE: Experience[] = [
  {
    role: { en: "Usability Lead", zh: "可用性负责人 (Usability Lead)" },
    project: "Sisyphus's Worst Day (again)",
    org: { en: "USC Advanced Games Project (AGP)", zh: "USC 高级游戏项目（AGP）" },
    dates: "Aug 2025 - May 2026",
    shipped: { en: "Shipped on Steam, Jul 2026", zh: "2026 年 7 月上线 Steam" },
    cover: "/experience/sisyphus.jpg",
    links: {
      steam: "https://store.steampowered.com/app/4700250/Sisyphuss_Worst_Day_again/",
      linkedin: "https://www.linkedin.com/company/sisyphus-s-worst-day-again/",
    },
    bullets: [
      {
        en: "Led usability across a year-long, 50+-person student game production: 50+ playtests, plus regular studio-wide “Everybody Tests” coordinated with the design and engineering leads.",
        zh: "在为期一年、50+ 人的学生游戏项目中负责可用性——组织 50+ 场 playtest，并与设计和工程负责人协调每期的全组「Everybody Tests」。",
      },
      {
        en: "Synthesized playtester observations into categorized, actionable issue reports routed to the right design and engineering channels, covering onboarding, camera controls, level readability, fail states, and difficulty pacing.",
        zh: "把玩家观察整理成分类、可执行的问题报告，分发到对应的设计与工程频道——覆盖新手引导、镜头操作、关卡可读性、失败状态与难度节奏。",
      },
      {
        en: "Surfaced recurring UX problems that drove concrete changes, like defaulting the camera to a zoomed-out view after players struggled with manual zoom, and flagging tutorial gaps and late-level difficulty spikes ahead of gold master.",
        zh: "发现反复出现的体验问题并推动具体改动——例如在玩家难以手动缩放后把镜头默认拉远，并在 gold master 前指出教学缺口与后期关卡的难度陡增。",
      },
    ],
  },
];
---

<section id="experience">
  <h2 class="section-title" data-i18n="expTitle">Experience</h2>

  {
    EXPERIENCE.map((exp) => (
      <article class="exp reveal-item">
        <div class="exp-head">
          <div class="exp-headline">
            <h3 class="exp-role">
              <T t={exp.role} />
            </h3>
            <p class="exp-sub">
              <span class="exp-project">{exp.project}</span>
              <T t={exp.org} class="exp-org" />
            </p>
            <p class="exp-meta">
              <span>{exp.dates}</span>
              {exp.shipped && <T t={exp.shipped} class="exp-shipped" />}
            </p>
          </div>

          <div class="exp-side">
            {exp.cover && (
              <a
                class="exp-cover"
                href={exp.links?.steam ?? exp.links?.linkedin ?? "#"}
                target="_blank"
                rel="noreferrer"
                aria-label={`${exp.project} on Steam`}
              >
                <img src={exp.cover} alt={`${exp.project} cover`} loading="lazy" decoding="async" width="460" height="215" />
              </a>
            )}
            {exp.links && (
              <div class="exp-links">
                {exp.links.steam && (
                  <a class="text-link" href={exp.links.steam} target="_blank" rel="noreferrer">
                    Steam <Icon name="arrow-up-right" size={13} />
                  </a>
                )}
                {exp.links.linkedin && (
                  <a class="text-link" href={exp.links.linkedin} target="_blank" rel="noreferrer">
                    LinkedIn <Icon name="arrow-up-right" size={13} />
                  </a>
                )}
              </div>
            )}
          </div>
        </div>

        <ul class="exp-bullets">
          {exp.bullets.map((b) => (
            <T t={b} as="li" />
          ))}
        </ul>
      </article>
    ))
  }
</section>
