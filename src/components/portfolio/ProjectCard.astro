---
import type { ProjectEntry } from "../../data/projects";
import T from "../T.astro";
import Icon from "../Icon.astro";

interface Props {
  project: ProjectEntry;
  index?: number; // drives the reveal stagger (--i)
}

const { project, index = 0 } = Astro.props;
const detailHref = `/projects/${project.id}`;
const clip = project.clip;
const yt = project.youtubeId;
---

<article class="project-card reveal-item" style={`--i: ${index}`}>
  {
    clip ? (
      <a class="project-media project-media-link" href={detailHref}>
        <video
          class="project-clip"
          poster={project.cover}
          src={clip}
          muted
          loop
          playsinline
          preload="none"
          autoplay
          data-autoplay-clip
        />
      </a>
    ) : yt ? (
      <button
        class="project-media yt-facade"
        type="button"
        data-youtube-id={yt}
        data-youtube-title={`${project.title}, gameplay video`}
        aria-label={`Play ${project.title} video`}
      >
        <img src={project.cover} alt="" loading="lazy" decoding="async" width="1280" height="720" />
        <span class="yt-play-btn">
          <Icon name="play" size={26} />
        </span>
      </button>
    ) : (
      <a class="project-media project-media-link" href={detailHref}>
        <img src={project.cover} alt="" loading="lazy" decoding="async" width="1280" height="720" />
      </a>
    )
  }

  <div class="project-content">
    <div class="project-meta">
      <T t={project.tag} class="project-tag" />
      <span class="project-year">{project.year}</span>
    </div>
    <h3><a href={detailHref}>{project.title}</a></h3>
    <T t={project.summary} as="p" class="project-summary" />
    <div class="project-card-footer">
      <div class="meta-chips">
        {project.chips.map((chip) => <T t={chip} class="meta-chip" />)}
      </div>
      <div class="card-links">
        {
          project.links?.itch && (
            <a class="card-ext" href={project.links.itch} target="_blank" rel="noreferrer">
              itch.io <Icon name="arrow-up-right" size={13} />
            </a>
          )
        }
        <a class="card-cta" href={detailHref}>
          <span data-i18n="caseStudyCta">Read case study</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </div>
</article>
