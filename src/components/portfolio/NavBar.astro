---
import { SITE } from "../../data/site";
import Icon from "../Icon.astro";
---

<nav>
  <div class="container nav-inner">
    <a href="/" class="logo">{SITE.name}</a>
    <div class="nav-controls">
      <div class="nav-links">
        <a href="/#projects" data-i18n="navProjects">Projects</a>
        <a href="/#experience" data-i18n="navExperience">Experience</a>
        <a href="/#about" data-i18n="navAbout">About</a>
        <a href="/#contact" data-i18n="navContact">Contact</a>
        {
          SITE.resumeUrl && (
            <a
              href={SITE.resumeUrl}
              target="_blank"
              rel="noreferrer"
              data-i18n="navResume"
              data-i18n-href
              data-href-en={SITE.resumeUrl}
              data-href-zh={SITE.resumeUrlZh || SITE.resumeUrl}
            >
              Resume
            </a>
          )
        }
      </div>
      <div class="lang-switch">
        <button class="lang-btn active" type="button" data-lang="en">EN</button>
        <button class="lang-btn" type="button" data-lang="zh">中</button>
      </div>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle light / dark mode" title="Light / dark">
        <span class="icon-sun"><Icon name="sun" size={15} /></span>
        <span class="icon-moon"><Icon name="moon" size={15} /></span>
      </button>
    </div>
  </div>
</nav>
