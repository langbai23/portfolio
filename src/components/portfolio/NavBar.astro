---
import { SITE } from "../../data/site";
---

<nav>
  <div class="container nav-inner">
    <a href="/" class="logo">{SITE.name}</a>
    <div class="nav-controls">
      <div class="nav-links">
        <a href="/#projects" data-i18n="navProjects">Projects</a>
        <a href="/#experience" data-i18n="navExperience">Experience</a>
        <a href="/#about" data-i18n="navAbout">About</a>
        <a href="/#contact" data-i18n="navContact">Contact</a>
        {
          SITE.resumeUrl && (
            <a href={SITE.resumeUrl} target="_blank" rel="noreferrer" data-i18n="navResume">
              Resume
            </a>
          )
        }
      </div>
      <div class="lang-switch">
        <button class="lang-btn active" type="button" data-lang="en">EN</button>
        <button class="lang-btn" type="button" data-lang="zh">中</button>
      </div>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
    </div>
  </div>
</nav>
