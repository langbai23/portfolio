---
import { SITE } from "../../data/site";
import { FEATURED_PROJECT } from "../../data/projects";
import Icon from "../Icon.astro";

const featured = FEATURED_PROJECT;
---

<!-- The hero asset is the latest project's clip; its poster is the LCP image. -->
<link rel="preload" as="image" href={featured.cover} />

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow" data-i18n="heroEyebrow">Game designer &amp; developer, USC</p>
    <h1 class="hero-name">{SITE.name}</h1>
    <p class="hero-intro" data-i18n="heroIntro">
      Stories told through systems. USC game design sophomore, Usability Lead on a Steam-shipped
      title, building narrative games in Unity.
    </p>
    <div class="button-row">
      <a class="button primary" href="/#projects" data-i18n="heroPrimaryBtn">View projects</a>
      <a class="button" href="/#contact" data-i18n="heroSecondaryBtn">Get in touch</a>
    </div>
  </div>

  <a class="hero-visual" href={`/projects/${featured.id}`} aria-label={`${featured.title} case study`}>
    <span class="hero-frame">
      {
        featured.clip ? (
          <video
            poster={featured.cover}
            src={featured.clip}
            muted
            loop
            playsinline
            preload="metadata"
            autoplay
            data-autoplay-clip
          />
        ) : (
          <img src={featured.cover} alt="" width="1280" height="720" decoding="async" />
        )
      }
    </span>
    <span class="hero-visual-caption">
      <span data-i18n="featuredLabel">Latest</span>
      <strong>{featured.title}</strong>
      <Icon name="arrow-right" size={15} />
    </span>
  </a>
</section>
