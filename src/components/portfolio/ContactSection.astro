---
import { SITE } from "../../data/site";
import Icon from "../Icon.astro";
---

<section id="contact">
  <div class="contact-band">
    <h2 class="section-title" data-i18n="contactTitle">Let's connect</h2>
    <p class="section-subtitle" data-i18n="contactSubtitle">
      Open to game design and development internships. Email is fastest; LinkedIn works too.
    </p>
    <a class="contact-email" href={`mailto:${SITE.email}`}>
      <span>{SITE.email}</span>
      <Icon name="arrow-up-right" size={28} />
    </a>
    <div class="contact-links">
      <a class="text-link" href={SITE.linkedin} target="_blank" rel="noreferrer">
        <span data-i18n="contactLinkedInLabel">LinkedIn</span>
        <Icon name="arrow-up-right" size={14} />
      </a>
      {
        SITE.github && (
          <a class="text-link" href={SITE.github} target="_blank" rel="noreferrer">
            <span data-i18n="contactGithubLabel">GitHub</span>
            <Icon name="arrow-up-right" size={14} />
          </a>
        )
      }
      {
        SITE.resumeUrl && (
          <a
            class="text-link"
            href={SITE.resumeUrl}
            target="_blank"
            rel="noreferrer"
            data-i18n-href
            data-href-en={SITE.resumeUrl}
            data-href-zh={SITE.resumeUrlZh || SITE.resumeUrl}
          >
            <span data-i18n="contactResumeLabel">Resume (PDF)</span>
            <Icon name="arrow-up-right" size={14} />
          </a>
        )
      }
    </div>
  </div>
</section>
