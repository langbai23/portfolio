---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const resolvedOgImage = ogImage
  ? Astro.site
    ? new URL(ogImage, Astro.site).toString()
    : ogImage
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta name="twitter:card" content={resolvedOgImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
    <meta name="theme-color" content="#0b0b0d" />
    <script is:inline>
      // Apply the saved theme before first paint so there is no flash.
      // Default is dark; "light" only if the visitor chose it.
      (function () {
        try {
          var t = localStorage.getItem("site-theme") === "light" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Self-hosted variable font (latin subset); CJK falls back to system fonts. -->
    <link rel="preload" href="/fonts/Geist-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* ---------------------------------------------------------------- *
   * Overhaul: one sans family (Geist), near-black zinc ground, a single *
   * electric-blue accent, soft 16px surfaces with pill controls.       *
   * Content and IA are unchanged; only the visual language is new.    *
   *                                                                    *
   * Shape rule: cards/media 16px, chips/buttons pill. Nothing sharp.   *
   * ---------------------------------------------------------------- */
  @font-face {
    font-family: "Geist";
    src: url("/fonts/Geist-var.woff2") format("woff2");
    font-weight: 300 800;
    font-style: normal;
    font-display: swap;
  }

  :root {
    color-scheme: dark;
    --bg: #0b0b0d;
    --surface: #131316;
    --surface-2: #1b1b20;
    --media-bg: #151519;
    --text: #f1f0ec;
    --text-soft: #c8c8cf;
    --muted: #8f8f99;
    --accent: #5b8def;
    --accent-strong: #7fa6ff;
    --accent-soft: rgba(91, 141, 239, 0.14);
    --on-accent: #0b0b0d;
    --line: rgba(241, 240, 236, 0.09);
    --line-strong: rgba(241, 240, 236, 0.16);
    --nav-bg: rgba(11, 11, 13, 0.72);
    --shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.9);
    --r-card: 16px;
    --r-media: 12px;
    --r-pill: 999px;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --sans: "Geist", system-ui, -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  }

  html[data-theme="light"] {
    color-scheme: light;
    --bg: #f5f5f3;
    --surface: #ffffff;
    --surface-2: #ececea;
    --media-bg: #e6e6e3;
    --text: #111113;
    --text-soft: #3a3a40;
    --muted: #6b6b74;
    --accent: #2b63d9;
    --accent-strong: #1f4fb3;
    --accent-soft: rgba(43, 99, 217, 0.1);
    --on-accent: #ffffff;
    --line: rgba(17, 17, 19, 0.1);
    --line-strong: rgba(17, 17, 19, 0.18);
    --nav-bg: rgba(245, 245, 243, 0.78);
    --shadow: 0 40px 90px -44px rgba(17, 17, 19, 0.35);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    background: var(--bg);
  }

  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    font-feature-settings: "ss01", "cv11";
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img,
  video {
    max-width: 100%;
  }

  .icon {
    display: inline-block;
    vertical-align: -0.15em;
    flex-shrink: 0;
  }

  ::selection {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  h1,
  h2,
  h3 {
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  html[lang="zh-CN"] h1,
  html[lang="zh-CN"] h2,
  html[lang="zh-CN"] h3 {
    letter-spacing: 0;
  }

  /* ------------------------------ nav ------------------------------ */
  nav {
    position: sticky;
    top: 0;
    /* lightningcss adds -webkit-backdrop-filter; see astro.config.mjs */
    backdrop-filter: blur(16px) saturate(140%);
    background: var(--nav-bg);
    border-bottom: 1px solid var(--line);
    z-index: 10;
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 64px;
  }

  .logo {
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
  }

  .nav-controls {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-links {
    display: flex;
    gap: 4px;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .nav-links a {
    padding: 6px 12px;
    border-radius: var(--r-pill);
    transition: color 0.2s ease, background 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .lang-switch {
    display: flex;
    padding: 3px;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
  }

  .lang-btn {
    padding: 4px 10px;
    border-radius: var(--r-pill);
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.8rem;
    font-family: var(--sans);
    transition: color 0.2s ease, background 0.2s ease;
  }

  .lang-btn.active {
    color: var(--text);
    background: var(--surface-2);
  }

  .lang-btn:hover {
    color: var(--text);
  }

  .theme-toggle {
    appearance: none;
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .theme-toggle span {
    display: grid;
    place-items: center;
  }

  .theme-toggle .icon-sun {
    display: none;
  }

  html[data-theme="dark"] .theme-toggle .icon-sun,
  html:not([data-theme]) .theme-toggle .icon-sun {
    display: grid;
  }

  html[data-theme="dark"] .theme-toggle .icon-moon,
  html:not([data-theme]) .theme-toggle .icon-moon {
    display: none;
  }

  /* ------------------------------ hero ----------------------------- */
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px;
    align-items: center;
    padding: 64px 0 24px;
  }

  .hero-copy {
    grid-column: 1 / span 6;
    min-width: 0;
  }

  /* The one eyebrow on the page. */
  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: 0.86rem;
    color: var(--muted);
    margin-bottom: 22px;
  }

  .eyebrow-name {
    color: var(--text);
    font-weight: 600;
  }

  .eyebrow-name::after {
    content: ",";
  }

  h1.hero-title {
    font-size: clamp(2.8rem, 5.4vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin-bottom: 22px;
    text-wrap: balance;
  }

  html[lang="zh-CN"] h1.hero-title {
    line-height: 1.12;
  }

  .hero-intro {
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 40ch;
    margin-bottom: 30px;
  }

  .button-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-strong);
    font-size: 0.92rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--text);
    background: transparent;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.25s var(--ease);
  }

  .button:hover {
    background: var(--surface-2);
    border-color: var(--line-strong);
    transform: translateY(-1px);
  }

  .button:active {
    transform: translateY(0) scale(0.98);
  }

  .button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .button.primary:hover {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
  }

  .button.primary .icon {
    transition: transform 0.25s var(--ease);
  }

  .button.primary:hover .icon {
    transform: translateX(3px);
  }

  /* Reel: three tiles, the first spans both rows. */
  .hero-reel {
    grid-column: 7 / span 6;
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    grid-template-rows: auto auto;
    gap: 12px;
    min-width: 0;
  }

  .reel-tile {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .reel-tile:first-child {
    grid-row: 1 / span 2;
  }

  .reel-media {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-media);
    overflow: hidden;
    background: var(--media-bg);
    border: 1px solid var(--line);
    transition: border-color 0.25s ease;
  }

  .reel-tile:first-child .reel-media {
    aspect-ratio: auto;
    flex: 1;
    box-shadow: var(--shadow);
  }

  .reel-media video,
  .reel-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }

  .reel-tile:hover .reel-media {
    border-color: var(--accent);
  }

  .reel-tile:hover video {
    transform: scale(1.03);
  }

  .reel-caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .reel-title {
    color: var(--text);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .reel-tile:hover .reel-title {
    color: var(--accent-strong);
  }

  /* Entry: copy in sequence, then tiles. */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-copy > * {
    animation: rise 0.7s var(--ease) both;
  }

  .hero-copy > :nth-child(1) {
    animation-delay: 0.05s;
  }

  .hero-copy > :nth-child(2) {
    animation-delay: 0.12s;
  }

  .hero-copy > :nth-child(3) {
    animation-delay: 0.2s;
  }

  .hero-copy > :nth-child(4) {
    animation-delay: 0.28s;
  }

  .reel-tile {
    animation: rise 0.8s var(--ease) both;
    animation-delay: calc(0.25s + var(--i, 0) * 0.09s);
  }

  /* ---------------------------- sections --------------------------- */
  section {
    padding: 112px 0 0;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 12px;
  }

  .section-subtitle {
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 56ch;
    margin-bottom: 40px;
  }

  .pill-tag,
  .meta-chip {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: var(--r-pill);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-soft);
    background: var(--surface-2);
    border: 1px solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .meta-chip {
    font-size: 0.76rem;
    padding: 4px 10px;
  }

  .pill-tag:hover {
    border-color: var(--line-strong);
    color: var(--text);
  }

  .text-link,
  .card-cta,
  .card-ext {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .text-link,
  .card-ext {
    color: var(--muted);
  }

  .text-link:hover,
  .card-ext:hover {
    color: var(--text);
  }

  .card-cta {
    color: var(--accent-strong);
  }

  .card-cta .icon {
    transition: transform 0.25s var(--ease);
  }

  .card-cta:hover .icon {
    transform: translateX(3px);
  }

  .project-tag {
    color: var(--accent-strong);
    font-weight: 500;
    font-size: 0.86rem;
  }

  .project-year {
    color: var(--muted);
    font-size: 0.86rem;
    font-variant-numeric: tabular-nums;
  }

  /* -------------------------- sticky stack ------------------------- */
  /* Each game card pins under the nav; the next one scrolls over it.
     Later cards sit a few px lower so the stacked edges read as a deck. */
  .stack {
    display: block;
  }

  .stack-card {
    position: sticky;
    top: calc(80px + var(--i, 0) * 10px);
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    overflow: hidden;
    box-shadow: var(--shadow);
    margin-bottom: 28px;
  }

  .stack-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--media-bg);
    overflow: hidden;
    border-right: 1px solid var(--line);
  }

  .stack-media video,
  .stack-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }

  .stack-card:hover .stack-media video,
  .stack-card:hover .stack-media img {
    transform: scale(1.03);
  }

  .stack-body {
    display: flex;
    flex-direction: column;
    padding: 32px 36px;
    min-width: 0;
  }

  .stack-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
  }

  .stack-card h3 {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    margin-bottom: 12px;
  }

  .stack-card h3 a:hover {
    color: var(--accent-strong);
  }

  .stack-summary {
    color: var(--muted);
    font-size: 0.98rem;
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    overflow: hidden;
  }

  .meta-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .stack-links {
    margin-top: auto;
    padding-top: 22px;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* Click-to-play YouTube facade */
  .yt-facade {
    appearance: none;
    border: 0;
    margin: 0;
    padding: 0;
    width: 100%;
    cursor: pointer;
    font: inherit;
    color: var(--text);
  }

  .yt-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: var(--r-pill);
    color: var(--on-accent);
    background: var(--accent);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    transition: transform 0.25s var(--ease), background 0.2s ease;
    z-index: 3;
  }

  .yt-play-btn .icon {
    margin-left: 2px;
  }

  .yt-facade:hover .yt-play-btn,
  .yt-facade:focus-visible .yt-play-btn {
    transform: translate(-50%, -50%) scale(1.06);
    background: var(--accent-strong);
  }

  .yt-facade.is-playing .yt-play-btn,
  .yt-facade.is-playing img {
    opacity: 0;
  }

  .yt-facade iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    z-index: 4;
  }

  /* Other work: exactly two cells. */
  .others {
    margin-top: 56px;
  }

  .others-title {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 18px;
  }

  .others-grid,
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    overflow: hidden;
    transition: transform 0.35s var(--ease), border-color 0.25s ease;
  }

  .project-card:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
  }

  .project-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--media-bg);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .project-media img,
  .project-media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }

  .project-card:hover .project-media img,
  .project-card:hover .project-media video {
    transform: scale(1.03);
  }

  .project-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 22px 24px 24px;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 10px;
  }

  .project-card h3 {
    font-size: 1.35rem;
    margin-bottom: 8px;
  }

  .project-card h3 a:hover {
    color: var(--accent-strong);
  }

  .project-summary {
    color: var(--muted);
    font-size: 0.94rem;
    margin-bottom: 18px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .project-card-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  /* Earlier work: collapsed by default. */
  .archive {
    margin-top: 28px;
    border-top: 1px solid var(--line);
  }

  .archive-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    cursor: pointer;
    color: var(--muted);
    font-size: 1.1rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .archive-summary::-webkit-details-marker {
    display: none;
  }

  .archive-summary:hover,
  .archive[open] .archive-summary {
    color: var(--text);
  }

  .archive-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .archive-count {
    display: inline-grid;
    place-items: center;
    min-width: 24px;
    height: 24px;
    padding: 0 8px;
    border-radius: var(--r-pill);
    background: var(--surface-2);
    color: var(--text-soft);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }

  .archive-chevron {
    transition: transform 0.3s var(--ease);
  }

  .archive[open] .archive-chevron {
    transform: rotate(90deg);
  }

  .archive-grid {
    padding-bottom: 8px;
  }

  /* --------------------------- reveal ------------------------------ */
  .reveal-item {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
    transition-delay: calc(var(--i, 0) * 70ms);
  }

  .reveal-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* -------------------------- experience --------------------------- */
  .exp {
    border-top: 1px solid var(--line-strong);
    padding-top: 32px;
  }

  .exp-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .exp-headline {
    min-width: 0;
    flex: 1 1 420px;
  }

  .exp-role {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 8px;
  }

  .exp-sub {
    font-size: 1.05rem;
    color: var(--text-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }

  .exp-project {
    font-weight: 500;
